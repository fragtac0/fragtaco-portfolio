@@ -0,0 +1,49 @@
+import { whenIdle } from "./idle";
+import { normalizePageViewSource } from "./page-view-source";
+
+/** The longest the counter's request waits for a quiet moment: a busy page still counts its visit within this time. */
+export const PAGE_VIEW_IDLE_TIMEOUT_MS = 2000;
+
+let lastTrackedRouteKey: string | null = null;
+/** Requests waiting for a quiet moment: each is sent at once if the page is left first (a visit that ended early is still a visit). */
+const waiting = new Set<() => void>();
+let listening = false;
+
+function send(source: string) {
+  // Low priority: the counter must not compete with the pictures and scripts the visitor is waiting for (guide `deprioritize-background-fetches`).
+  void fetch(`/api/page-view?source=${encodeURIComponent(source)}`, {
+    credentials: "same-origin",
+    keepalive: true,
+    method: "POST",
+    priority: "low",
+  }).catch(() => undefined);
+}
+
+function flushOnLeave() {
+  for (const go of [...waiting]) go();
+}
+
+/**
+ * Counts one page view per route key, once the page is idle (`requestIdleCallback`, forced after 2 s; a timer where it is missing).
+ * Client only. The same key again (a re-render, the effect running twice) sends nothing.
+ */
+export function trackPageView(pathname: string, search: string): void {
+  const routeKey = `${pathname}?${search}`;
+  if (lastTrackedRouteKey === routeKey) return;
+  lastTrackedRouteKey = routeKey;
+
+  const source = normalizePageViewSource(new URLSearchParams(search).get("source"));
+  let cancel = () => {};
+  const go = () => {
+    cancel();
+    waiting.delete(go);
+    send(source);
+  };
+  waiting.add(go);
+  cancel = whenIdle(go, PAGE_VIEW_IDLE_TIMEOUT_MS);
+
+  if (!listening) {
+    listening = true;
+    window.addEventListener("pagehide", flushOnLeave);
+  }
+}
