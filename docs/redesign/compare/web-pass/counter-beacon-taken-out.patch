+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+/** A window with a controllable idle queue and the listeners the beacon adds. */
+function fakeWindow() {
+  const idle = new Map<number, { cb: () => void; timeout?: number }>();
+  const listeners = new Map<string, () => void>();
+  let next = 1;
+  vi.stubGlobal("window", {
+    requestIdleCallback: (cb: () => void, opts?: { timeout: number }) => {
+      idle.set(next, { cb, timeout: opts?.timeout });
+      return next++;
+    },
+    cancelIdleCallback: (id: number) => void idle.delete(id),
+    addEventListener: (type: string, fn: () => void) => listeners.set(type, fn),
+  });
+  return {
+    idle,
+    runIdle: () => [...idle.values()].forEach((e) => e.cb()),
+    leave: () => listeners.get("pagehide")?.(),
+  };
+}
+
+beforeEach(() => {
+  vi.resetModules();
+  vi.stubGlobal("fetch", vi.fn(() => Promise.resolve(new Response(null, { status: 200 }))));
+});
+afterEach(() => vi.unstubAllGlobals());
+
+const load = async () => (await import("./page-view-beacon")).trackPageView;
+
+describe("trackPageView (Task 35, the counter's request)", () => {
+  it("sends nothing until the page is idle, then one low-priority keepalive POST", async () => {
+    const win = fakeWindow();
+    const track = await load();
+    track("/work", "");
+    expect(fetch).not.toHaveBeenCalled();
+    expect([...win.idle.values()].map((e) => e.timeout)).toEqual([2000]);
+    win.runIdle();
+    expect(fetch).toHaveBeenCalledTimes(1);
+    expect(fetch).toHaveBeenCalledWith("/api/page-view?source=organic", {
+      credentials: "same-origin",
+      keepalive: true,
+      method: "POST",
+      priority: "low",
+    });
+  });
+
+  it("sends one request per route key, not one per call", async () => {
+    const win = fakeWindow();
+    const track = await load();
+    track("/work", "");
+    track("/work", "");
+    win.runIdle();
+    track("/work", "");
+    win.runIdle();
+    expect(fetch).toHaveBeenCalledTimes(1);
+    track("/experience", "");
+    win.runIdle();
+    expect(fetch).toHaveBeenCalledTimes(2);
+    track("/work", "?source=twitter");
+    win.runIdle();
+    expect(fetch).toHaveBeenCalledTimes(3);
+    expect(vi.mocked(fetch).mock.calls[2][0]).toBe("/api/page-view?source=twitter");
+  });
+
+  it("falls back to a timer where requestIdleCallback is missing", async () => {
+    const set = vi.fn((cb: () => void) => {
+      cb();
+      return 1;
+    });
+    vi.stubGlobal("window", { setTimeout: set, clearTimeout: () => {}, addEventListener: () => {} });
+    const track = await load();
+    track("/", "");
+    expect(set).toHaveBeenCalledWith(expect.any(Function), 120);
+    expect(fetch).toHaveBeenCalledTimes(1);
+  });
+
+  it("sends a waiting request at once when the page is left first, and never twice", async () => {
+    const win = fakeWindow();
+    const track = await load();
+    track("/work", "");
+    win.leave();
+    expect(fetch).toHaveBeenCalledTimes(1);
+    expect(win.idle.size).toBe(0);
+    win.runIdle();
+    win.leave();
+    expect(fetch).toHaveBeenCalledTimes(1);
+  });
+
+  it("does not throw when the request fails", async () => {
+    const win = fakeWindow();
+    vi.stubGlobal("fetch", vi.fn(() => Promise.reject(new Error("offline"))));
+    const track = await load();
+    track("/work", "");
+    expect(() => win.runIdle()).not.toThrow();
+    await Promise.resolve();
+  });
+});
