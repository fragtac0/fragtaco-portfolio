  "eval": "new Promise(r=>{const g=[];let l=performance.now();const t0=l;function f(n){g.push(n-l);l=n;if(n-t0<3500)requestAnimationFrame(f);else{g.shift();g.sort((a,b)=>a-b);r({n:g.length,max:+g[g.length-1].toFixed(2),over20:g.filter(x=>x>20).length})}}requestAnimationFrame(f)})",
  "label": "desk-frames-dropin"
 },
