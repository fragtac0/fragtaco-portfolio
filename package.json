{
  "name": "new-portfolio",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- remix vite:dev",
    "build": "dotenv -e .env.local -- remix vite:build",
    "start": "dotenv -e .env.local -- remix-serve ./build/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:videos": "vite-node --config scripts/vite.sync.config.ts scripts/sync-videos.ts",
    "paintings": "node scripts/make-paintings.mjs",
    "lint": "eslint . --cache --cache-location .cache/eslint",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@remix-run/dev": "^2.17.4",
    "@remix-run/node": "^2.17.4",
    "@remix-run/react": "^2.17.4",
    "@remix-run/serve": "^2.17.4",
    "@tailwindcss/vite": "^4.1.13",
    "@upstash/redis": "^1.38.0",
    "@vercel/remix": "2.16.7-patch.1",
    "motion": "^12.36.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "shaders": "4.0.7",
    "tailwindcss": "^4.1.13",
    "three": "0.169.0",
    "vite": "^6.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.169.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.2.7"
  }
}
